{
  "AnalysisName": "Executive Sales & Profitability Dashboard",
  "DataSet": {
    "DataSetName": "aws_sales_analytics_parquet",
    "DataSourceType": "ATHENA",
    "AthenaDatabase": "aws_sales_analytics_db",
    "AthenaTable": "sales_data_parquet",
    "ImportMode": "SPICE"
  },
  "CalculatedFields": [
    {
      "Name": "Overall_Profit_Margin_Pct",
      "Expression": "sum({Profit}) / sum({NetSales}) * 100"
    },
    {
      "Name": "Average_Order_Value",
      "Expression": "avg({NetSales})"
    }
  ],
  "Visuals": [
    {
      "Type": "KPI",
      "Title": "Total Revenue (USD)",
      "Field": "sum(NetSales)",
      "Format": "Currency ($)"
    },
    {
      "Type": "KPI",
      "Title": "Total Orders Placed",
      "Field": "count(OrderID)"
    },
    {
      "Type": "KPI",
      "Title": "Average Profit Margin (%)",
      "Field": "Overall_Profit_Margin_Pct",
      "Format": "Percentage (%)"
    },
    {
      "Type": "BarChart",
      "Title": "Revenue & Profit by Region",
      "XAxis": "CustomerRegion",
      "Metrics": ["sum(NetSales)", "sum(Profit)"],
      "SortBy": "sum(NetSales) DESC"
    },
    {
      "Type": "DonutChart",
      "Title": "Revenue Share by Product Category",
      "Category": "ProductCategory",
      "Value": "sum(NetSales)"
    },
    {
      "Type": "LineChart",
      "Title": "Monthly Revenue Trend",
      "XAxis": "YearMonth",
      "Metric": "sum(NetSales)"
    }
  ]
}
